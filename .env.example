# --- Database (Neon, added via Vercel Marketplace) ---
# Vercel adds this automatically when you connect Neon to your project.
# For local dev, copy the value from Vercel > Storage > your Neon store > .env.local tab.
DATABASE_URL=

# --- File storage (Vercel Blob) ---
# Vercel adds this automatically when you create a Blob store.
# For local dev, copy the value from Vercel > Storage > your Blob store > .env.local tab.
BLOB_READ_WRITE_TOKEN=

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET=

# Only needed for local development (NextAuth auto-detects the URL on Vercel).
AUTH_URL=http://localhost:3000

# --- Access control ---
# The only 2 email addresses allowed to sign up / log in. Comma-separated, no spaces.
ALLOWED_EMAILS=you@example.com,partner@example.com
